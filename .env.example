# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RoadEye AI
# false + CDSE keys = real Sentinel-2 LEO scenes; true = Esri preview only
SATELLITE_MOCK_MODE=true

# Copernicus Data Space (Sentinel-2 LEO) — https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_PROCESS_API_URL=https://sh.dataspace.copernicus.eu/api/v1/process
# Prefer api/v1/statistics; code also tries /statistics/v1
COPERNICUS_STATS_API_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics

# AI — Gemini primary
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# gemini-2.0-flash is shut down — use 3.8 Flash (or gemini-4-argon for max quality)
GEMINI_VISION_MODEL=gemini-3.8-flash

# Supabase Free
# Local/direct: port 5432 · Vercel: prefer pooler port 6543
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[HASLO]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

CLOUD_COVERAGE_THRESHOLD=0.20
